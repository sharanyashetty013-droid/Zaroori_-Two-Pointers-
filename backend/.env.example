DATABASE_URL=sqlite:///./zaroori.db
# Render/Postgres example: postgresql://user:pass@host:5432/zaroori
APP_ENV=development            # set to production on Render: the app refuses to start with a weak ADMIN_API_KEY
# Dashboard roles (header X-API-Key). Higher role can do everything a lower one can.
ADMIN_API_KEY=change-me        # everything: hospitals, audit log, re-queue failed alerts
REVIEWER_API_KEY=              # flags, anomalies, alert status, review decisions
VIEWER_API_KEY=                # district map only
CORS_ORIGINS=*
FLAG_THRESHOLD=3
FLAG_WINDOW_DAYS=90
FLAG_MIN_ASHAS=2               # a hospital flag needs cases from at least this many different ASHAs
# ASHA login
ASHA_LOGIN_REQUIRED=1          # 0 = anyone can start a session (local demo only; production refuses to start with 0)
ASHA_MAX_SESSIONS_PER_DAY=30   # per ASHA account, limits damage from a stolen key
# Alert email (leave empty to just log a MOCK ALERT)
NGO_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_WEBHOOK_URL=             # optional: any WhatsApp/SMS gateway or Slack webhook that accepts JSON {text, district, alert_id}
ALERT_MAX_ATTEMPTS=8           # retries with backoff 30s,1m,2m... capped at 1h, then marked failed
ALERT_RETRY_SECONDS=60
# Rate limits per IP per minute
TRUSTED_PROXY_HOPS=0           # set 1 on Render so X-Forwarded-For cannot be spoofed
RATE_PER_MIN=120
RATE_WRITE_PER_MIN=20
RATE_AI_PER_MIN=30
RATE_AUTH_PER_MIN=30
# Anomaly check
ANOMALY_MIN_CASES=8
ANOMALY_MIN_COMPARISON=10
ANOMALY_ALPHA=0.05
# AI: set ONE (free Gemini key: aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
TTS_DIR=./tts_cache
